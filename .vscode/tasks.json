      "options": {
        "cwd": "${workspaceFolder}/services/geo",
        "env": {
          "FLAGS": "feature.zoning.land-use,feature.environment.soil,feature.environment.water-constraints,feature.geo.amenities,feature.geo.kgis-context,feature.geo.parcel-geometry,feature.geo.zone-resolver,feature.geo.transport-access,feature.geo.authority",
          "OVERPASS_URL": "https://overpass.openstreetmap.fr/api/interpreter",
          "KEYCLOAK_URL": "http://localhost:8180",
          "KEYCLOAK_REALM": "sat"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "servers", "panel": "dedicated", "reveal": "always" }
    },
    {
