    {
      "label": "svc: cadastral",
      "detail": ":8011 cadastral land records + overlays",
      "type": "process",
      "command": "${workspaceFolder}/services/cadastral/.venv/Scripts/uvicorn.exe",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8011", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/services/cadastral",
        "env": {
          "CADASTRAL_REPO_ROOT": "${workspaceFolder}/services/cadastral/cadastral-data",
          "CADASTRAL_DATA_DIR": "${workspaceFolder}/services/cadastral/cadastral-data/data/cadastral_lake_v2",
          "CADASTRAL_DB_PATH": "${workspaceFolder}/services/cadastral/cadastral-data/db/karnataka_lands_full.db",
          "WRIS_LAKES_PATH": "C:\\Users\\tanny\\Downloads\\wris_lakes (1).parquet",
          "FLAGS": "feature.cadastral.land-records,feature.cadastral.overlays",
          "KEYCLOAK_URL": "http://localhost:8180",
          "KEYCLOAK_REALM": "sat"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "servers", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "svc: report",
      "detail": ":8010 GO/NO-GO verdict aggregator (no auth)",
      "type": "process",
      "command": "${workspaceFolder}/services/report/.venv/Scripts/uvicorn.exe",
      "args": ["app.main:app", "--port", "8010"],
      "options": {
        "cwd": "${workspaceFolder}/services/report",
        "env": {
          "FLAGS": "feature.report.go-no-go"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "servers", "panel": "dedicated", "reveal": "always" }
    },

    {
      "label": "Build (web)",
      "detail": "next build (apps/web) with NODE_PATH set for OneDrive checkouts",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "NODE_PATH": "${workspaceFolder}/node_modules;${workspaceFolder}/apps/web/node_modules"
        }
      },
      "problemMatcher": [],
      "presentation": { "group": "build", "panel": "dedicated", "reveal": "always" }
    }
