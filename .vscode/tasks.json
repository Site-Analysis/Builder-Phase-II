{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Fullstack",
      "detail": "All services (8 analysis + cadastral + report) + frontend",
      "dependsOn": ["Backend", "Frontend", "svc: cadastral", "svc: report"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run All",
      "detail": "Start backend (8 services) + frontend",
      "dependsOn": ["Backend", "Frontend"],
      "dependsOrder": "parallel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend",
      "detail": "Next.js dev server (apps/web) on :3000",
      "type": "shell",
      "command": "$p = Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1; if ($p) { Stop-Process -Id $p.OwningProcess -Force -ErrorAction SilentlyContinue; Start-Sleep 1 }; npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web",
        "env": {
          "NODE_PATH": "${workspaceFolder}/node_modules;${workspaceFolder}/apps/web/node_modules"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "servers", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Backend",
      "detail": "All 10 analysis services (8000-8009)",
      "dependsOn": [
        "svc: temperature",
        "svc: sunpath",
        "svc: flood",
        "svc: wind",
        "svc: rainfall",
        "svc: geo",
        "svc: planning",
        "svc: infrastructure",
        "svc: future-infra",
        "svc: land-records"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },

    {
      "label": "svc: temperature",
      "detail": ":8000 thermal-profile",
      "type": "process",
      "command": "${workspaceFolder}/services/temperature/.venv/Scripts/uvicorn.exe",
      "args": ["app.main:app", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}/services/temperature",
        "env": {
          "FLAGS": "feature.temperature.thermal-profile",
          "KEYCLOAK_URL": "http://localhost:8180",
          "KEYCLOAK_REALM": "sat"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "servers", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "svc: sunpath",
      "detail": ":8001 sunpath diagram",
      "type": "process",
      "command": "${workspaceFolder}/services/sunpath/.venv/Scripts/uvicorn.exe",
      "args": ["app.main:app", "--port", "8001"],
      "options": {
        "cwd": "${workspaceFolder}/services/sunpath",
        "env": {
          "FLAGS": "feature.sunpath.diagram,feature.sunpath.solar-day",
          "KEYCLOAK_URL": "http://localhost:8180",
          "KEYCLOAK_REALM": "sat"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "servers", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "svc: flood",
      "detail": ":8002 flood risk",
      "type": "process",
      "command": "${workspaceFolder}/services/flood/.venv/Scripts/uvicorn.exe",
      "args": ["app.main:app", "--port", "8002"],
      "options": {
        "cwd": "${workspaceFolder}/services/flood",
        "env": {
          "FLAGS": "feature.flood.risk-analysis",
          "KEYCLOAK_URL": "http://localhost:8180",
          "KEYCLOAK_REALM": "sat"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "servers", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "svc: wind",
      "detail": ":8003 wind analysis",
