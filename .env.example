# Copy to .env and fill in values. Never commit .env.

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Comma-separated list of enabled flags. All features default off.
# Available flags:
#   feature.temperature.thermal-profile
#   feature.flood.risk-analysis
#   feature.sunpath.diagram
#   feature.wind.climatology
FLAGS=

# ── Google Earth Engine ───────────────────────────────────────────────────────
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=secrets/service-account.json

# ── Keycloak (identity provider) ─────────────────────────────────────────────
# Backend services resolve keycloak via Docker DNS (http://keycloak:8080).
# Override KEYCLOAK_URL only if running outside docker-compose.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=sat
KEYCLOAK_CLIENT_ID=sat-web
KC_ADMIN_PASSWORD=changeme     # change before deploy

# next-auth (required when running Next.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=               # generate: openssl rand -base64 32

# ── Supabase (project DB persistence — auth replaced by Keycloak) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — server-side only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=     # Supabase dashboard → Settings → API → service_role

# ── Service URLs (used by frontend) ──────────────────────────────────────────
NEXT_PUBLIC_TEMPERATURE_API_URL=http://localhost:8000
NEXT_PUBLIC_SUNPATH_API_URL=http://localhost:8001
NEXT_PUBLIC_FLOOD_API_URL=http://localhost:8002
NEXT_PUBLIC_WIND_API_URL=http://localhost:8003
NEXT_PUBLIC_GEO_API_URL=http://localhost:8004
NEXT_PUBLIC_CADASTRAL_API_URL=http://localhost:8011

# ── Cadastral service data paths (port 8011) ──────────────────────────────────
# Submodule is at services/cadastral-data/ — after cloning with --recurse-submodules
# these defaults work out of the box. Only override if you cloned the data repo elsewhere.
# Feature flags: feature.cadastral.land-records, feature.cadastral.overlays
#
# NOTE: db/karnataka_lands_full.db is NOT in git (639 MB). Build it once:
#   cd services/cadastral-data/db && python build_db.py
#
CADASTRAL_REPO_ROOT=./services/cadastral-data
CADASTRAL_DATA_DIR=./services/cadastral-data/data
CADASTRAL_DB_PATH=./services/cadastral-data/db/karnataka_lands_full.db
# All overlay parquets default to CADASTRAL_REPO_ROOT/data/<name>.parquet
# Override individually only if files live elsewhere:
# BBMP_ROAD_WIDTH_PATH=
# BWSSB_SEWERAGE_PATH=
# OSM_POWERLINES_PATH=
# ENCROACHMENT_PATH=
# LGD_VILLAGES_PATH=

# ── Open-Meteo (no key required — public API) ─────────────────────────────────
# OPEN_METEO_BASE_URL defaults to https://archive-api.open-meteo.com/v1/archive

# ── IMD data (Temperature service) ───────────────────────────────────────────
IMD_DATA_DIR=./data

# ── Firebase (SiteAnalysisV2 frontend only) ───────────────────────────────────
# Only needed if running the SiteAnalysisV2 frontend
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Backend services (docker-compose): collector runs in-stack, no change needed.
# OTEL_EXPORTER_OTLP_ENDPOINT and OTEL_TRACES_EXPORTER set per-service in docker-compose.yml.
#
# Next.js on Vercel: set these in Vercel dashboard → Settings → Environment Variables.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://<EC2-PUBLIC-IP>:4318
#   OTEL_SERVICE_NAME=sat-web
#
# Jaeger UI (after docker-compose up): http://localhost:16686
# AWS: open port 4318 (OTLP/HTTP) and 16686 (Jaeger UI) in security group.
