# apps/web environment variables
# Copy to .env for local dev. Set in Vercel dashboard for production.
# Never commit .env — it is gitignored.
# Note: remove all comment lines before pasting into Vercel bulk-import.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://jaqlvsilsrdjeehqrump.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only — Vercel env, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── NextAuth + Keycloak ───────────────────────────────────────────────────────
# Local dev values shown. Production: swap localhost for builder.qnit.site / auth.builder.qnit.site
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=sat
KEYCLOAK_CLIENT_ID=sat-web

# ── Service base URLs ─────────────────────────────────────────────────────────
# Production: set all to https://api.builder.qnit.site (Caddy routes by path prefix)
NEXT_PUBLIC_TEMPERATURE_API_URL=http://localhost:8000
NEXT_PUBLIC_SUNPATH_API_URL=http://localhost:8001
NEXT_PUBLIC_FLOOD_API_URL=http://localhost:8002
NEXT_PUBLIC_WIND_API_URL=http://localhost:8003
NEXT_PUBLIC_RAINFALL_API_URL=http://localhost:8004
NEXT_PUBLIC_GEO_API_URL=http://localhost:8005
NEXT_PUBLIC_PLANNING_API_URL=http://localhost:8006
NEXT_PUBLIC_INFRA_API_URL=http://localhost:8007
NEXT_PUBLIC_FUTURE_INFRA_API_URL=http://localhost:8008
NEXT_PUBLIC_LAND_RECORDS_API_URL=http://localhost:8009
NEXT_PUBLIC_REPORT_API_URL=http://localhost:8010
NEXT_PUBLIC_CADASTRAL_API_URL=http://localhost:8011
# Generic base used by some components — set same as above in prod
NEXT_PUBLIC_API_BASE_URL=http://localhost:8005
# Self-hosted Overpass mirror — set to https://api.builder.qnit.site/overpass in prod if enabled
NEXT_PUBLIC_OVERPASS_URL=http://localhost:12345/api/interpreter

# ── Feature toggles ───────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGIN_URL=/login
NEXT_PUBLIC_ENABLE_PARCELS=1
NEXT_PUBLIC_ENABLE_PARCEL_ANALYSIS=1
NEXT_PUBLIC_ENABLE_CADASTRAL=1

# ── MapTiler (3D basemap) ─────────────────────────────────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=
