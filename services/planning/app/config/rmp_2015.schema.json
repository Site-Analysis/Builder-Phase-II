{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat:planning/rmp-2015-config",
  "title": "BDA RMP-2015 buildable-envelope lookup config",
  "description": "Authoritative-tier. Cells transcribed from RMP-2015 Vol-III printed Zoning-Regulation tables (IndiaCode, zoning_regulations_rmp2015f.pdf; Table 22 = FAR & ground coverage, Table 8 = setbacks by height & plot size, + three-ring land-use classification) and verified against the plan's worked examples. Provenance is SPLIT: regulatory_source = PRIMARY citation (required + non-null for any 'authoritative' or 'derived' cell); transcription_origin = where the value was read THIS time (OpenCity = 'inferred'). A cell you cannot read from the primary PDF stays EMPTY + PENDING; NBCS-2026 fallback cells are 'derived' and carry karnataka_adoption_status. Dated overlays (e.g. 11-Nov-2025 UDD setback amendment) live in amendments[]. Enforced at load time by app/config/rmp_loader.py.",
  "type": "object",
  "required": ["config_version", "status", "cells", "transcription_origin"],
  "properties": {
    "config_version": { "type": "string" },
    "plan_name": { "type": "string" },
    "ruleset_name": { "type": "string" },
    "regulatory_source": { "$ref": "#/$defs/regulatory_source" },
    "transcription_origin": { "$ref": "#/$defs/transcription_origin" },
    "karnataka_adoption_status": { "type": "string", "description": "e.g. 'not_adopted_as_of:2026-06' — required on derived (NBCS) cells; may be set at config level for inheritance" },
    "enforceability_note": { "type": "string" },
    "source_note": { "type": "string" },
    "transcription_blocker": { "type": "string" },
    "status": { "type": "string", "enum": ["template-empty", "partial-unverified", "verified"] },
    "fallback_ruleset": { "type": "string" },
    "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
    "amendments": { "type": "array", "items": { "$ref": "#/$defs/amendment" } }
  },
  "$defs": {
    "band": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": ["number", "null"], "minimum": 0, "description": "null = open-ended upper band" }
      }
    },
    "regulatory_source": {
      "type": ["object", "null"],
      "description": "PRIMARY citation. REQUIRED + non-null for any 'authoritative'/'derived' cell or config.",
      "required": ["doc", "page_ref"],
      "properties": {
        "doc": { "type": "string", "minLength": 1, "description": "e.g. 'RMP-2015 Vol-III' or 'SP 7:2026 (NBCS 2026)'" },
        "page_ref": { "type": "string", "minLength": 1, "description": "exact page/table, e.g. 'Table 22, p.NN'" },
        "url": { "type": "string" }
      }
    },
    "transcription_origin": {
      "type": "object",
      "description": "Where the digitized value was actually read THIS time. May be OpenCity ('inferred').",
      "required": ["source", "confidence"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["authoritative", "derived", "inferred"] },
        "url": { "type": "string" }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "ring", "road_width_band_m", "plot_size_band_sqm", "far", "ground_coverage", "setbacks", "ecs", "mixed_use_pct", "confidence", "transcription_origin"],
      "properties": {
        "zone": { "enum": ["Residential", "Commercial", "Industrial", "Mixed Use", "Institutional", "Agricultural", "Green Belt", "Water Body", "Restricted"] },
        "ring": { "enum": ["I", "II", "III"], "description": "I core / II core-ORR / III beyond (RMP-2015 three-ring classification)" },
        "road_width_band_m": { "$ref": "#/$defs/band" },
        "plot_size_band_sqm": { "$ref": "#/$defs/band" },
        "far": { "type": "number", "exclusiveMinimum": 0 },
        "ground_coverage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "setbacks": {
          "type": "object",
          "required": ["front_m", "rear_m", "side_m"],
          "additionalProperties": false,
          "properties": {
            "front_m": { "type": "number", "minimum": 0 },
            "rear_m": { "type": "number", "minimum": 0 },
            "side_m": { "type": "number", "minimum": 0 }
          }
        },
        "ecs": {
          "type": "object",
          "required": ["basis", "value_per_100sqm"],
          "properties": {
            "basis": { "type": "string", "minLength": 1 },
            "value_per_100sqm": { "type": "number", "minimum": 0 },
            "visitor_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "mixed_use_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confidence": { "enum": ["authoritative", "derived", "inferred"], "description": "'authoritative'/'derived' REQUIRE a non-null regulatory_source; 'derived' (NBCS fallback) also requires karnataka_adoption_status. OpenCity-only -> 'inferred'." },
        "effective_date": { "type": "string", "description": "ISO date the base value takes effect (for dated bases; amendments live in amendments[])" },
        "karnataka_adoption_status": { "type": "string", "description": "required on 'derived' NBCS cells, e.g. 'not_adopted_as_of:2026-06'" },
        "enforceability_note": { "type": "string" },
        "regulatory_source": { "$ref": "#/$defs/regulatory_source" },
        "transcription_origin": { "$ref": "#/$defs/transcription_origin" }
      }
    },
    "amendment": {
      "type": "object",
      "description": "A DATED overlay on a base cell (current/strictest governs; base cell is never overwritten).",
      "required": ["effective_date", "applies_to", "supersedes", "status", "transcription_origin"],
      "properties": {
        "id": { "type": "string" },
        "effective_date": { "type": "string", "description": "ISO date, e.g. '2025-11-11'" },
        "applies_to": { "type": "string", "description": "e.g. 'plots <= 4000 sqm brackets'" },
        "supersedes": { "type": "string", "description": "the base cell key/id this modifies" },
        "status": { "type": "string", "description": "'draft' | 'notified' — confirm from primary" },
        "setbacks": {
          "type": "object",
          "properties": {
            "front_m": { "type": "number", "minimum": 0 },
            "rear_m": { "type": "number", "minimum": 0 },
            "side_m": { "type": "number", "minimum": 0 }
          }
        },
        "confidence": { "enum": ["authoritative", "derived", "inferred"] },
        "regulatory_source": { "$ref": "#/$defs/regulatory_source" },
        "transcription_origin": { "$ref": "#/$defs/transcription_origin" }
      }
    }
  }
}
