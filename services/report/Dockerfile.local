# Local-only build — uses pre-built sat-land-records image to avoid network.
# On EC2 use the standard Dockerfile (has internet, pip works).
FROM sat-land-records

WORKDIR /app
COPY . .

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8010/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010", "--reload"]
